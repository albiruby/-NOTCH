{
  "$schema": "notch.design-system.surfaces/1",
  "version": "1.0.0",
  "centralPill": {
    "density": "compact",
    "background": "{color.graphite.900}",
    "tint": "{color.violet.950}",
    "glass": 0.8,
    "blur": "{glass.blur.lg}",
    "radius": "{radius.pill}",
    "height": 34,
    "minWidth": 180,
    "maxWidth": 260
  },
  "expandedSurface": {
    "density": "expanded",
    "background": "{color.graphite.900}",
    "tint": "{color.violet.950}",
    "glass": 0.8,
    "blur": "{glass.blur.lg}",
    "radius": "{radius.xl}",
    "width": 460,
    "height": 250,
    "padding": "{space.6}"
  },
  "widget": {
    "density": "standard",
    "background": "{color.bg.surface}",
    "glass": "{glass.opacity.solid}",
    "radius": "{radius.lg}",
    "padding": "{space.4}"
  },
  "workspace": {
    "density": "workspace",
    "background": "{color.bg.base}",
    "glass": "{glass.opacity.solid}",
    "radius": "{radius.2xl}",
    "padding": "{space.8}"
  },
  "settings": {
    "density": "workspace",
    "background": "{color.bg.base}",
    "glass": 1.0,
    "radius": "{radius.lg}",
    "padding": "{space.6}"
  }
}
