{
  "$schema": "notch.design-system.tokens/1",
  "version": "1.0.0",
  "color": {
    "graphite": {
      "950": "#090A0D",
      "900": "#101216",
      "850": "#14171D",
      "800": "#171A20",
      "750": "#1C2028",
      "700": "#20242D",
      "600": "#2B303A",
      "500": "#414856",
      "400": "#707989",
      "300": "#A0A6B2",
      "200": "#C8CCD5",
      "100": "#E8EAF0"
    },
    "violet": {
      "950": "#171329",
      "900": "#292440",
      "800": "#51458F",
      "700": "#7464EB",
      "600": "#8B7CFF",
      "500": "#A194FF",
      "400": "#B9AEFF",
      "300": "#D4CEFF"
    },
    "state": {
      "success": "#4ADE80",
      "warning": "#FBBF24",
      "danger": "#FB7185",
      "info": "#60A5FA"
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "size": {
    "icon": { "xs": 12, "sm": 16, "md": 18, "lg": 20, "xl": 24 },
    "control": { "compact": 28, "standard": 36, "large": 44 },
    "hitTarget": 44,
    "sidebar": 240,
    "panelMin": 280
  },
  "radius": {
    "xs": 4,
    "sm": 6,
    "md": 10,
    "lg": 16,
    "xl": 22,
    "2xl": 28,
    "pill": 999
  },
  "border": {
    "width": { "default": 1, "emphasis": 2 }
  },
  "typography": {
    "family": {
      "ui": "Segoe UI Variable",
      "uiFallback": "Segoe UI",
      "mono": "Cascadia Code",
      "monoFallback": "Cascadia Mono"
    },
    "scale": {
      "display": { "size": 32, "weight": 600, "lineHeight": 1.25 },
      "h1": { "size": 24, "weight": 600, "lineHeight": 1.3 },
      "h2": { "size": 20, "weight": 600, "lineHeight": 1.3 },
      "h3": { "size": 16, "weight": 600, "lineHeight": 1.35 },
      "title": { "size": 14, "weight": 600, "lineHeight": 1.4 },
      "body": { "size": 14, "weight": 400, "lineHeight": 1.5 },
      "bodySm": { "size": 13, "weight": 400, "lineHeight": 1.45 },
      "label": { "size": 12, "weight": 500, "lineHeight": 1.3 },
      "caption": { "size": 11, "weight": 400, "lineHeight": 1.35 },
      "micro": { "size": 10, "weight": 500, "lineHeight": 1.2 }
    }
  },
  "glass": {
    "opacity": { "subtle": 0.68, "standard": 0.8, "solid": 0.9 },
    "blur": { "sm": 8, "md": 16, "lg": 24 },
    "borderOpacity": 0.3,
    "highlightOpacity": 0.1
  },
  "motion": {
    "instant": 80,
    "fast": 120,
    "normal": 180,
    "smooth": 220,
    "slow": 300,
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)",
      "spring": "critically-damped"
    }
  },
  "elevation": {
    "0": { "shadow": "none" },
    "1": { "shadow": "0 1 2 rgba(0,0,0,0.25)" },
    "2": { "shadow": "0 8 24 rgba(0,0,0,0.35)" },
    "3": { "shadow": "0 16 48 rgba(0,0,0,0.45)" }
  }
}
